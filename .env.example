# ==========================================================
# JobPilot AI — Environment Configuration (.env.example)
# Copy this file to .env before running `docker compose up -d`
# ==========================================================

# 1. Core Database & Security
POSTGRES_USER=jobpilot_user
POSTGRES_PASSWORD=jobpilot_password
POSTGRES_DB=jobpilot_db
JWT_SECRET=generate_a_random_jwt_secret_key_here
ENCRYPTION_KEY=generate_a_fernet_compatible_encryption_key_here

# 2. Email Alerts (SMTP / Gmail App Password)
# To send job application links directly to your email via Gmail:
# Enable 2-Step Verification on your Google Account -> Generate an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# 3. WhatsApp Job Alerts (Choose ANY ONE provider below)
# Option A: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option B: Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Option C: CallMeBot (Free Personal WhatsApp Alerts) or Custom Webhook
CALLMEBOT_API_KEY=
WHATSAPP_WEBHOOK_URL=

# 4. Gmail Inbox Lifecycle Sync (Optional OAuth 2.0)
GMAIL_CLIENT_ID=your_gmail_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8001/api/gmail/callback
